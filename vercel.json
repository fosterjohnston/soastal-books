{
  "version": 2,
  "installCommand": "npm install",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    { "src": "api/session.js", "use": "@vercel/node" },
    { "src": "api/books.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/session", "dest": "/api/session.js" },
    { "src": "/api/books", "dest": "/api/books.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
